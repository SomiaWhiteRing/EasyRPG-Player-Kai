+// Original Maniac SavePicture chunk 6 includes the image kind in its high byte.
+// Keep the standard boolean view for other engines and retain the complete word.
+template <class S>
+struct ManiacPictureFlagsField : public TypedField<S, bool> {
+	using Base = TypedField<S, bool>;
+	using Base::Base;
+	static int32_t Value(const S& obj) {
+		const uint32_t follow = obj.fixed_to_map ? (obj.maniac_image_flags & 255 ? obj.maniac_image_flags & 255 : 1) : 0;
+		return static_cast<int32_t>((obj.maniac_image_flags & 0xffffff00) | follow);
+	}
+	void ReadLcf(S& obj, LcfReader& stream, uint32_t length) const override {
+		int32_t value = 0;
+		TypeReader<int32_t>::ReadLcf(value, stream, length);
+		obj.maniac_image_flags = static_cast<uint32_t>(value);
+		obj.fixed_to_map = (value & 255) != 0;
+	}
+	void WriteLcf(const S& obj, LcfWriter& stream) const override {
+		TypeReader<int32_t>::WriteLcf(Value(obj), stream);
+	}
+	int LcfSize(const S& obj, LcfWriter& stream) const override {
+		return TypeReader<int32_t>::LcfSize(Value(obj), stream);
+	}
+	bool IsDefault(const S& obj, const S& ref, bool) const override {
+		return Value(obj) == Value(ref);
+	}
+};
+
+// Text pictures reuse the transparency word for byte-sized character/line spacing.
+template <class S>
+struct ManiacPictureTransparencyField : public TypedField<S, bool> {
+	using Base = TypedField<S, bool>;
+	using Base::Base;
+	static int32_t Value(const S& obj) {
+		const uint32_t alpha = obj.use_transparent_color ? (obj.maniac_transparency_flags & 255 ? obj.maniac_transparency_flags & 255 : 1) : 0;
+		return static_cast<int32_t>((obj.maniac_transparency_flags & 0xffffff00) | alpha);
+	}
+	void ReadLcf(S& obj, LcfReader& stream, uint32_t length) const override {
+		int32_t value = 0;
+		TypeReader<int32_t>::ReadLcf(value, stream, length);
+		obj.maniac_transparency_flags = static_cast<uint32_t>(value);
+		obj.use_transparent_color = (value & 255) != 0;
+	}
+	void WriteLcf(const S& obj, LcfWriter& stream) const override {
+		TypeReader<int32_t>::WriteLcf(Value(obj), stream);
+	}
+	int LcfSize(const S& obj, LcfWriter& stream) const override {
+		return TypeReader<int32_t>::LcfSize(Value(obj), stream);
+	}
+	bool IsDefault(const S& obj, const S& ref, bool) const override {
+		return Value(obj) == Value(ref);
+	}
+};
+
+// Chunk 0x12 is a double in unpatched engines, but two little-endian int32
+// dimensions in Maniac. Buffer both views until the runtime selects the engine.
+template <class S>
+struct ManiacPictureDimensionsField : public TypedField<S, double> {
+	using Base = TypedField<S, double>;
+	using Base::Base;
+	void ReadLcf(S& obj, LcfReader& stream, uint32_t length) const override {
+		Base::ReadLcf(obj, stream, length);
+		uint64_t bits = 0;
+		std::memcpy(&bits, &obj.current_bot_trans, sizeof(bits));
+		obj.maniac_image_dimensions = {static_cast<int32_t>(bits), static_cast<int32_t>(bits >> 32)};
+	}
+	void WriteLcf(const S& obj, LcfWriter& stream) const override {
+		if ((obj.maniac_picture_active || obj.maniac_image_flags >> 24 == 1 || obj.maniac_image_flags >> 24 == 2) && obj.maniac_image_dimensions.size() == 2)
+			stream.Write(obj.maniac_image_dimensions);
+		else Base::WriteLcf(obj, stream);
+	}
+	bool IsDefault(const S& obj, const S& ref, bool is2k3) const override {
+		return obj.maniac_picture_active || obj.maniac_image_flags >> 24 == 1 || obj.maniac_image_flags >> 24 == 2
+			? obj.maniac_image_dimensions.empty() : Base::IsDefault(obj, ref, is2k3);
+	}
+};
+
+// Chunk 0x18 is a raw little-endian finish word in Maniac. Keep the bool
+// view and one-byte format for ordinary RPG_RT saves.
+template <class S>
+struct ManiacPictureFinishField : public TypedField<S, bool> {
+	using Base = TypedField<S, bool>;
+	using Base::Base;
+	void ReadLcf(S& obj, LcfReader& stream, uint32_t length) const override {
+		if (length == 4) {
+			std::vector<int32_t> word;
+			stream.Read(word, 4);
+			obj.maniac_spritesheet_finish = word[0];
+		}
+		else {
+			Base::ReadLcf(obj, stream, length);
+			obj.maniac_spritesheet_finish = obj.spritesheet_play_once ? 1 : 0;
+		}
+		obj.spritesheet_play_once = obj.maniac_spritesheet_finish == 1;
+	}
+	void WriteLcf(const S& obj, LcfWriter& stream) const override {
+		if (obj.maniac_picture_active) stream.Write(std::vector<int32_t>{obj.maniac_spritesheet_finish});
+		else Base::WriteLcf(obj, stream);
+	}
+	int LcfSize(const S& obj, LcfWriter& stream) const override {
+		return obj.maniac_picture_active ? 4 : Base::LcfSize(obj, stream);
+	}
+	bool IsDefault(const S& obj, const S& ref, bool is2k3) const override {
+		return obj.maniac_picture_active ? obj.maniac_spritesheet_finish == ref.maniac_spritesheet_finish : Base::IsDefault(obj, ref, is2k3);
+	}
+};
+
+// Known flags retain the existing bool API; opaque lifecycle bits survive LSD.
+template <class S>
+struct ManiacPictureLifecycleField : public TypedField<S, typename S::Flags> {
+	using Base = TypedField<S, typename S::Flags>;
+	using Base::Base;
+	static int32_t Value(const S& obj) {
+		uint32_t value = obj.maniac_lifecycle_flags & ~127u;
+		for (size_t i = 0; i < obj.flags.flags.size(); ++i) value |= uint32_t(obj.flags.flags[i]) << i;
+		return static_cast<int32_t>(value);
+	}
+	void ReadLcf(S& obj, LcfReader& stream, uint32_t length) const override {
+		int32_t value = 0;
+		TypeReader<int32_t>::ReadLcf(value, stream, length);
+		obj.maniac_lifecycle_flags = static_cast<uint32_t>(value);
+		for (size_t i = 0; i < obj.flags.flags.size(); ++i) obj.flags.flags[i] = (obj.maniac_lifecycle_flags & (1u << i)) != 0;
+	}
+	void WriteLcf(const S& obj, LcfWriter& stream) const override {
+		TypeReader<int32_t>::WriteLcf(Value(obj), stream);
+	}
+	int LcfSize(const S& obj, LcfWriter& stream) const override {
+		return TypeReader<int32_t>::LcfSize(Value(obj), stream);
+	}
+	bool IsDefault(const S& obj, const S& ref, bool) const override {
+		return Value(obj) == Value(ref);
+	}
+};
+
+// Native Maniac globals omit an all-zero array and retain raw switch bytes.
+// The explicit active flag keeps ordinary boolean save writing unchanged.
+template <class S>
+struct ManiacGlobalSwitchesField : public TypedField<S, std::vector<bool>> {
+	using Base = TypedField<S, std::vector<bool>>;
+	using Base::Base;
+	void ReadLcf(S& obj, LcfReader& stream, uint32_t length) const override {
+		stream.Read(obj.maniac_switch_payload, length);
+		obj.maniac_switch_payload_present = true;
+		obj.switches.assign(obj.maniac_switch_payload.begin(), obj.maniac_switch_payload.end());
+	}
+	void WriteLcf(const S& obj, LcfWriter& stream) const override {
+		if (obj.maniac_global_scalars_active) stream.Write(obj.maniac_switch_payload);
+		else Base::WriteLcf(obj, stream);
+	}
+	int LcfSize(const S& obj, LcfWriter& stream) const override {
+		return obj.maniac_global_scalars_active ? static_cast<int>(obj.maniac_switch_payload.size())
+			: Base::LcfSize(obj, stream);
+	}
+	bool IsDefault(const S& obj, const S& ref, bool is2k3) const override {
+		return obj.maniac_global_scalars_active && Base::IsDefault(obj, ref, is2k3);
+	}
+};
+
+template <class S>
+struct ManiacGlobalVariablesField : public TypedField<S, std::vector<int32_t>> {
+	using Base = TypedField<S, std::vector<int32_t>>;
+	using Base::Base;
+	bool IsDefault(const S& obj, const S& ref, bool is2k3) const override {
+		return obj.maniac_global_scalars_active && Base::IsDefault(obj, ref, is2k3);
+	}
+};
+
+// SaveSystem's format marker follows this field in original saves. Buffer it
+// until LSD_Reader knows whether lengths count codepage bytes or UTF16 units.
+template <class S>
+struct ManiacGlobalStringsField : public TypedField<S, std::vector<DBString>> {
+	using Base = TypedField<S, std::vector<DBString>>;
+	using Base::Base;
+	void ReadLcf(S& obj, LcfReader& stream, uint32_t length) const override {
+		stream.Read(obj.maniac_string_payload, length);
+		obj.maniac_string_payload_present = true;
+	}
+	void WriteLcf(const S& obj, LcfWriter& stream) const override {
+		if (obj.maniac_strings_utf16) stream.Write(obj.maniac_string_payload);
+		else Base::WriteLcf(obj, stream);
+	}
+	int LcfSize(const S& obj, LcfWriter& stream) const override {
+		return obj.maniac_strings_utf16 ? static_cast<int>(obj.maniac_string_payload.size())
+			: Base::LcfSize(obj, stream);
+	}
+	bool IsDefault(const S& obj, const S& ref, bool is2k3) const override {
+		return obj.maniac_strings_utf16 ? obj.maniac_string_payload.empty()
+			: Base::IsDefault(obj, ref, is2k3);
+	}
+};
